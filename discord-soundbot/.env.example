# Copy this to .env for local testing only - on Unraid these get entered
# directly as container environment variables, never as a file.

DISCORD_TOKEN=your-bot-token-here
WEB_USERNAME=admin
WEB_PASSWORD=change-me
SESSION_SECRET=generate-a-long-random-string-here
COOLDOWN_SECONDS=3
IDLE_DISCONNECT_SECONDS=10
WEB_PORT=8080
